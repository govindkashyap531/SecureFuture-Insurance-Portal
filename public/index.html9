<section id="calculator">
  <div class="container">
    <h2>Premium Calculator</h2>

    <div class="card" style="max-width:500px;margin:auto;">
      <input type="number" id="amount" placeholder="Enter Amount">

<input type="number" id="age" placeholder="Your Age">

<select id="plan">
  <option value="life">Life Insurance</option>
  <option value="health">Health Insurance</option>
  <option value="motor">Motor Insurance</option>
</select>
      <button onclick="calculatePremium()" class="btn" style="margin-top:15px;">
        Calculate Premium
      </button>

      <h3 id="result" style="margin-top:20px;"></h3>
    </div>
  </div>
</section> 
<section id="contact">

<div class="container">

<h2>Contact Us</h2>

<form id="leadForm">

<input type="text" placeholder="Full Name" required>

<input type="email" placeholder="Email Address" required>

<input type="tel" placeholder="Mobile Number" required>

<select required>
<option value="">Select Insurance</option>
<option>Life Insurance</option>
<option>Health Insurance</option>
<option>Motor Insurance</option>
<option>Investment Plan</option>
</select>

<textarea placeholder="Write your message..." rows="5"></textarea>

<button type="submit">Get Free Consultation</button>

</form>

<p id="message"></p>

</div>

